{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/tsgo/refs/heads/main/schema.json",
  "extends": "./tsconfig.base.json",
  "references": [{ "path": "tsconfig.packages.json" }],
  "include": [
    "**/vitest.*.ts", // All vitest config files across all packages
    "./packages/*/test/**/*.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      // Path aliases let tests load internal modules and other workspace packages
      // that would otherwise be considered cyclic dependencies
      "@digital-shelf/api": ["./packages/api/src/index.ts"],
      "@digital-shelf/api/*": ["./packages/api/src/*"],
      "@digital-shelf/core": ["./packages/core/src/index.ts"],
      "@digital-shelf/core/test/*": ["./packages/core/test/*"],
      "@digital-shelf/core/*": ["./packages/core/src/*"],
      "@digital-shelf/domain": ["./packages/domain/src/index.ts"],
      "@digital-shelf/domain/*": ["./packages/domain/src/*"],
      "@digital-shelf/infra/*": ["./packages/infra/src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": [],
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": true,
        "diagnosticSeverity": {
          "unknownInEffectCatch": "off",
          "multipleEffectProvide": "off"
        }
      }
    ]
  }
}
