{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/tsgo/refs/heads/main/schema.json",
  "extends": "./tsconfig.base.json",
  "references": [{ "path": "tsconfig.packages.json" }],
  "include": [
    "**/vitest.*.ts", // All vitest config files across all packages
    "./packages/*/test/**/*.ts",
    "./apps/*/test/**/*.ts",
    "./apps/web/src/lib/auth*.ts", // Browser helpers exercised by the root test project
    "./alchemy.run.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      // Path aliases let tests load internal modules and other workspace packages
      // that would otherwise be considered cyclic dependencies
      "@app/core/test/*": ["./packages/core/test/*"],
      "@app/core/*": ["./packages/core/src/*"],
      "@app/db": ["./packages/db/src/db.ts"],
      "@app/db/schema": ["./packages/db/src/schema/index.ts"],
      "@app/db/*": ["./packages/db/src/*"],
      "@app/schema/*": ["./packages/schema/src/*"],
      "@app/infra": ["./packages/infra/src/index.ts"],
      "@app/infra/*": ["./packages/infra/src/*"],
      "@app/protocol/*": ["./packages/protocol/src/*"],
      "@app/client": ["./packages/client/src/index.ts"],
      "@app/client/*": ["./packages/client/src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": [],
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": true,
        "diagnosticSeverity": {
          "unknownInEffectCatch": "off",
          "multipleEffectProvide": "off"
        }
      }
    ]
  }
}
