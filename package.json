{
  "name": "effect-digital-shelf",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.0-rc.112",
      "@effect/ai-openai-compat": "4.0.0-rc.112",
      "@effect/atom-react": "4.0.0-rc.112",
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/platform-node": "4.0.0-rc.112",
      "@effect/sql-pg": "4.0.0-rc.112",
      "@effect/sql-pglite": "4.0.0-rc.112",
      "pg": "8.23.0",
      "@types/pg": "8.23.1",
      "@electric-sql/pglite": "0.5.8",
      "@effect/vitest": "4.0.0-rc.112",
      "@effect/tsgo": "0.45.0",
      "@types/node": "26.5.0",
      "typescript": "7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
      "vite-plus": "0.3.1",
      "vitest": "4.1.11",
      "alchemy": "2.0.0-beta.77",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "better-auth": "1.7.3",
      "@better-auth/drizzle-adapter": "1.7.3",
      "@better-auth/core": "1.7.3",
      "@better-auth/mcp": "1.7.3",
      "@cloudflare/playwright": "1.3.6",
      "jsonrepair": "3.15.0",
      "@oxlint/plugins": "1.81.0"
    }
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:types": "tsc -b tsconfig.json",
    "test": "vp test --run",
    "prepare": "effect-tsgo patch",
    "dev": "bun run dev:server & bun run dev:web & wait",
    "dev:server": "alchemy dev --env-file .env.dev",
    "dev:web": "bun run --filter @digital-shelf/web dev",
    "build:web": "bun run --filter @digital-shelf/web build",
    "deploy": "alchemy deploy",
    "deploy:dev": "bun run build:web && CI=true alchemy deploy --stage dev --env-file .env.dev --yes",
    "db:migrate": "bun run --filter @digital-shelf/infra db:migrate"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
