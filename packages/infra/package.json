{
  "name": "@digital-shelf/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test --run",
    "db:generate": "drizzle-kit generate",
