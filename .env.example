# Stage configuration for the Alchemy deploy and the Worker's Config reads.
#
# Copy to `.env.dev` or `.env.prod` (both gitignored) and fill it in, or run
# `scripts/provision-stage.sh <stage>`, which walks the dashboards, validates
# every value and writes the same names as GitHub Actions environment secrets
# and variables for the deploy jobs. Never commit a filled-in copy.
#
# Secrets are marked (secret); everything else is plain stage config.

# --- Alchemy / Cloudflare ------------------------------------------------
# One scoped API token: Workers Scripts, Workers Routes, Workflows, Hyperdrive,
# R2, AI Gateway, Browser Rendering, DNS on npbrands.com.au, Account Settings
# read. (secret)
CLOUDFLARE_API_TOKEN=
# The NP Brands account.
CLOUDFLARE_ACCOUNT_ID=3056ba6cc5916b47fece5b044c6a8434
# Hostname the stage's Worker serves; dev has a custom domain, prod stays on
# workers.dev until the cutover (ADR 0006). AUTH_BASE_URL derives from it.
SERVER_HOSTNAME=shelf-dev.apps.npbrands.com.au

# --- Postgres (PlanetScale) ------------------------------------------------
# Direct origin credentials (port 5432, TLS). Used by `pnpm db:migrate` and as
# the Hyperdrive origin Alchemy adopts the stage's config with. (secret)
DATABASE_URL=postgres://postgres.<branch_id>:<password>@<host>:5432/postgres?sslmode=verify-full
# The stage's Hyperdrive config, for reference only: Alchemy adopts it by name.
HYPERDRIVE_CONFIG_ID=

# --- Better Auth --------------------------------------------------------------
# `openssl rand -base64 32`, one per stage. (secret)
AUTH_SECRET=
AUTH_BASE_URL=https://shelf-dev.apps.npbrands.com.au
# Comma-separated; defaults to npbrands.com.au when unset.
AUTH_ALLOWED_EMAIL_DOMAINS=npbrands.com.au

# --- Postmark (magic-link mail) ---------------------------------------------
# Server API token of the server that sends from npbrands.com.au. (secret)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
# Defaults to "outbound" when unset.
POSTMARK_MESSAGE_STREAM=outbound

# --- Scrappey --------------------------------------------------------------------
# (secret)
SCRAPPEY_API_KEY=
# Defaults to the public Scrappey endpoint when unset.
SCRAPPEY_ENDPOINT=

# --- AI Gateway / Workers AI -------------------------------------------------
AI_GATEWAY_ACCOUNT_ID=3056ba6cc5916b47fece5b044c6a8434
# The stage's gateway name: digital-shelf-ai-gateway-<stage>.
AI_GATEWAY_ID=digital-shelf-ai-gateway-dev
# API token with Account > Workers AI > Read. (secret)
AI_GATEWAY_TOKEN=
# Defaults to @cf/zai-org/glm-4.7-flash when unset.
EXTRACTION_MODEL=

# --- Axiom (telemetry) --------------------------------------------------------
# The organisation's regional edge domain (Axiom Settings > General).
AXIOM_DOMAIN=
# Ingest-only token scoped to digital-shelf-traces-<stage> and
# digital-shelf-logs-<stage>. (secret)
AXIOM_TOKEN=
